{
  "name": "the-nfl-schedule",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An unofficial, timezone-aware viewer for the NFL season — schedule, week-by-week, standings, playoff bracket, and league leaders.",
  "author": "Chester Ismay",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --no-file-parallelism",
    "coverage:badge": "vitest run --coverage --no-file-parallelism && node scripts/coverage-badge.mjs",
    "fetch:schedule": "node scripts/fetch-schedule.mjs --season 2026",
    "fetch:history": "node scripts/fetch-history.mjs",
    "check:schedule": "node scripts/check-schedule.mjs --season 2026",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
